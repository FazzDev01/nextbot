<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android" id="cordova-plugin-termux-runner" version="1.0.0">
    <name>TermuxRunner</name>
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="TermuxRunner">
                <param name="android-package" value="com.nextbot.termux.TermuxRunner" />
            </feature>
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
            <queries>
                <package android:name="com.termux" />
            </queries>
        </config-file>
        <source-file src="src/android/TermuxRunner.java" target-dir="src/com/nextbot/termux" />
    </platform>
</plugin>
